@model IEnumerable<TARge25Shop.Models.Spaceship.SpaceshipIndexViewModel>

<div>
    <a asp-action="create" asp-controller="spaceship" type="submit" class="btn btn-primary">Create</a>
</div>

@{
    short rowNumber = 1;
}


<div class="h1">
    Spaceships
</div>
<form method="get">
    <table class="table table-hover table-dark">
        <thead>
            <tr>
                <th class="text-success" scope="col">Nr</th>
                <th class="text-success" scope="col">Name</th>
                <th class="text-success" scope="col">Type</th>
                <th class="text-success" scope="col">Built Date</th>
                <th class="text-success" scope="col">Crew</th>
                <th class="text-success" scope="col"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var spaceship in Model)
            {
                <tr>
                    <td class="text-success">@rowNumber</td>
                    <td class="text-success">@spaceship.Name</td>
                    <td class="text-success">@spaceship.ShipType</td>
                    <td class="text-success">@spaceship.CreatedAt</td>
                    <td class="text-success">@spaceship.Crew</td>
                    <td>
                        <a asp-action="details" asp-controller="spaceship" asp-route-id="@spaceship.Id" class="btn btn-primary">Details</a>
                        <a asp-action="update" asp-controller="spaceship" asp-route-id="@spaceship.Id" class="btn btn-primary">Update</a>
                        <a asp-action="delete" asp-controller="spaceship" asp-route-id="@spaceship.Id" class="btn btn-danger">Delete</a>
                    </td>
                </tr>
                rowNumber += 1;
            }
        </tbody>
    </table>
</form>

