@model IEnumerable<TARge25Shop.Models.RealEstate.RealEstateIndexViewModel>

<div>
    <a asp-action="create" asp-controller="realEstate" type="submit" class="btn btn-primary">Create</a>
</div>

@{
    short rowNumber = 1;
}


<div class="h1 text-center text-uppercase">
    RealEstate
</div>
<form method="get">
    <table class="table table-hover table-dark">
        <thead>
            <tr>
                <th class="text-success" scope="col">Nr</th>
                <th class="text-success" scope="col">Area</th>
                <th class="text-success" scope="col">Location</th>
                <th class="text-success" scope="col">Room Nr</th>
                <th class="text-success" scope="col">Building Type</th>
                <th class="text-success" scope="col"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var realEstate in Model)
            {
                <tr>
                    <td class ="text-success">@rowNumber</td>
                    <td class="text-success">@realEstate.Area</td>
                    <td class="text-success">@realEstate.Location</td>
                    <td class="text-success">@realEstate.RoomNumber</td>
                    <td class="text-success">@realEstate.BuildingType</td>
                    <td>
                        <a asp-action="details" asp-controller="realEstate" asp-route-id="@realEstate.Id" class="btn btn-primary">Details</a>
                        <a asp-action="update" asp-controller="realEstate" asp-route-id="@realEstate.Id" class="btn btn-primary">Update</a>
                        <a asp-action="delete" asp-controller="realEstate" asp-route-id="@realEstate.Id" class="btn btn-danger">Delete</a>
                    </td>
                </tr>
                rowNumber += 1;
            }
        </tbody>
    </table>
</form>