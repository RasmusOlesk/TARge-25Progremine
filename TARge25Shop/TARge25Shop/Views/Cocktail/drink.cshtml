@model TARge25Shop.Models.Cocktail.CocktailViewModel

<div class="container">
    <h2>Search Cocktails</h2>

    <form asp-controller="Cocktail"
          asp-action="Drink"
          method="get"
          class="mb-4">

        <div class="input-group">
            <input type="text"
                   name="searchTerm"
                   class="form-control bg-black"
                   placeholder="Enter a cocktail or a letter"
                   value="@Context.Request.Query["searchTerm"]"
                   required />

            <button type="submit" class="btn btn-primary">
                Search
            </button>
        </div>
    </form>

    @if (ViewBag.Message != null)
    {
        <div class="alert alert-warning">
            @ViewBag.Message
        </div>
    }

    @if (Model != null && !string.IsNullOrEmpty(Model.strDrink))
    {
        <hr />

        <h2>@Model.strDrink</h2>

        @if (!string.IsNullOrEmpty(Model.strDrinkThumb))
        {
            <img src="@Model.strDrinkThumb"
                 alt="@Model.strDrink"
                 class="img-fluid rounded mb-3"
                 style="max-width: 300px;" />
        }

        <dl class="row text-success">

            <dt class="col-sm-3">Alternate name</dt>
            <dd class="col-sm-9">@Model.strDrinkAlternate</dd>

            <dt class="col-sm-3">Tags</dt>
            <dd class="col-sm-9">@Model.strTags</dd>

            <dt class="col-sm-3">Category</dt>
            <dd class="col-sm-9">@Model.strCategory</dd>

            <dt class="col-sm-3">IBA</dt>
            <dd class="col-sm-9">@Model.strIBA</dd>

            <dt class="col-sm-3">Alcoholic</dt>
            <dd class="col-sm-9">@Model.strAlcoholic</dd>

            <dt class="col-sm-3">Glass</dt>
            <dd class="col-sm-9">@Model.strGlass</dd>

            <dt class="col-sm-3">Instructions</dt>
            <dd class="col-sm-9">@Model.strInstructions</dd>

            <dt class="col-sm-3">Video</dt>
            <dd class="col-sm-9">
                @if (!string.IsNullOrEmpty(Model.strVideo))
                {
                    <a href="@Model.strVideo" target="_blank">Watch video</a>
                }
            </dd>

        </dl>

        <h4>Ingredients and measurements</h4>

        <ul>
            @if (!string.IsNullOrWhiteSpace(Model.strIngredient1))
            {
                <li>@Model.strMeasure1 @Model.strIngredient1</li>
            }
            @if (!string.IsNullOrWhiteSpace(Model.strIngredient2))
            {
                <li>@Model.strMeasure2 @Model.strIngredient2</li>
            }
            @if (!string.IsNullOrWhiteSpace(Model.strIngredient3))
            {
                <li>@Model.strMeasure3 @Model.strIngredient3</li>
            }
            @if (!string.IsNullOrWhiteSpace(Model.strIngredient4))
            {
                <li>@Model.strMeasure4 @Model.strIngredient4</li>
            }
            @if (!string.IsNullOrWhiteSpace(Model.strIngredient5))
            {
                <li>@Model.strMeasure5 @Model.strIngredient5</li>
            }
            @if (!string.IsNullOrWhiteSpace(Model.strIngredient6))
            {
                <li>@Model.strMeasure6 @Model.strIngredient6</li>
            }
            @if (!string.IsNullOrWhiteSpace(Model.strIngredient7))
            {
                <li>@Model.strMeasure7 @Model.strIngredient7</li>
            }
            @if (!string.IsNullOrWhiteSpace(Model.strIngredient8))
            {
                <li>@Model.strMeasure8 @Model.strIngredient8</li>
            }
            @if (!string.IsNullOrWhiteSpace(Model.strIngredient9))
            {
                <li>@Model.strMeasure9 @Model.strIngredient9</li>
            }
            @if (!string.IsNullOrWhiteSpace(Model.strIngredient10))
            {
                <li>@Model.strMeasure10 @Model.strIngredient10</li>
            }
            @if (!string.IsNullOrWhiteSpace(Model.strIngredient11))
            {
                <li>@Model.strMeasure11 @Model.strIngredient11</li>
            }
            @if (!string.IsNullOrWhiteSpace(Model.strIngredient12))
            {
                <li>@Model.strMeasure12 @Model.strIngredient12</li>
            }
            @if (!string.IsNullOrWhiteSpace(Model.strIngredient13))
            {
                <li>@Model.strMeasure13 @Model.strIngredient13</li>
            }
            @if (!string.IsNullOrWhiteSpace(Model.strIngredient14))
            {
                <li>@Model.strMeasure14 @Model.strIngredient14</li>
            }
            @if (!string.IsNullOrWhiteSpace(Model.strIngredient15))
            {
                <li>@Model.strMeasure15 @Model.strIngredient15</li>
            }
        </ul>
    }

    <hr />

    <a asp-action="Drink"
           asp-controller="Cocktail"
           class="btn btn-success">
        Back
    </a>
</div>
