
<div class="container">
    <form method="get" asp-controller="cocktail" asp-action="drink">
        <div class="row">
            <div class="form-group col-md-offset-3 col-md-5">
                <h2>Welcome to Cocktail site</h2>
            </div>
        </div>

        <div class="row">
            <div class="form-group col-md-offset-3 col-md-5">
                <div class="input-group">
                    <input type="text"
                           name="searchString"
                           class="form-control"
                           placeholder="Search for a cocktail..." />

                    <span class="input-group-btn">
                        <button type="submit" class="btn btn-primary">
                            Search
                        </button>
                    </span>
                </div>
            </div>
        </div>
    </form>
</div>
