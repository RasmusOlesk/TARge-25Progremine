@model TARge25Shop.Models.ChuckNorris.ChuckNorrisViewModel

<div class="container">
     <h2>Today's Chuck Norris Joke is:</h2>
     @* <h2>@Html.DisplayFor(model => model.Categories)</h2>*@
     <hr />
     <dl class="row text-dark">
         <div class="form-group row">
             <label as-for="CreatedAt" class="col-sm-2 col-form-label"></label>
             @Html.DisplayFor(Model => Model.Id)
         </div>
     </dl>
    <dl class="row text-dark">
        <div class="form-group row">
            <label as-for="IconUrl" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(Model => Model.Id)
        </div>
    </dl>
    <dl class="row text-dark">
        <div class="form-group row">
            <label as-for="Id" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(Model => Model.Id)
        </div>
    </dl>
    <dl class="row text-dark">
        <div class="form-group row">
            <label as-for="UpdatedAt" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(Model => Model.Id)
        </div>
    </dl>
    <dl class="row text-dark">
        <div class="form-group row">
            <label as-for="Url" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(Model => Model.Id)
        </div>
    </dl>
    <dl class="row text-dark">
        <div class="form-group row">
            <label as-for="Value" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(Model => Model.Id)
        </div>
    </dl>
</div>
<hr />

<div>
    <form method="post">
        <button asp-controller="chuckNorris" asp-action="Joke" class="btn btn-primary">Joke</button> 
    </form>
</div>

