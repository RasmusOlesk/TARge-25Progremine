@model TARge25Shop.Models.Account.ResetPasswordViewModel


<h2>
    Reset Password
</h2>
<hr />
<div class="row">
    <div class="col-md-12">
        <form method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <input asp-for="Token" type="hidden" />
            <input asp-for="Email" type="hidden" />

            <div class="form-group">
                <label asp-for="Password"></label>
                <input asp-for="Password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmationPassword"></label>
                <input asp-for="ConfirmationPassword" class="form-control" />
                <span asp-validation-for="ConfirmationPassword" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">
                Update
            </button>
        </form>
    </div>
</div>