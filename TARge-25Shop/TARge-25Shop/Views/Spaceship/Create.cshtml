@model IEnumerable<TARge_25Shop.Models.Spaceship.SpaceshipCreateViewModel>

<div>
    <a asp-action="create" asp-controller="spaceship" type="submit" class="btn btn-primary">create</a>
</div>

<div class="h1">
    Spaceships
</div>
<form method="get">
    <table class="table table-hover">
        <thead>
            <tr>
                <th scope="col">"Nr"</th>
                <th scope="col">"Name"</th>
                <th scope="col">"Type"</th>
                <th scope="col">"Built Date"</th>
                <th scope="col">"Crew"</th>
                <th scope="col">""</th>
            </tr>
        </thead>
    </table>
    <div class="form-group"row>
        <lable asp-for="Name" class="col-sm-2 col-form-label"></lable>
        <div class="col-sm-10">
            <input asp-for="Name" class="form-control"/>
        </div>
    </div>

    <div class="form-group" row>
        <lable asp-for="ShipType" class="col-sm-2 col-form-label"></lable>
        <div class="col-sm-10">
            <input asp-for="ShipType" class="form-control" />
        </div>
    </div>

    <div class="form-group" row>
        <lable asp-for="Crew" class="col-sm-2 col-form-label"></lable>
        <div class="col-sm-10">
            <input asp-for="Crew" class="form-control" />
        </div>
    </div>

    <div class="form-group" row>
        <lable asp-for="EnginePower" class="col-sm-2 col-form-label"></lable>
        <div class="col-sm-10">
            <input asp-for="EnginePower" class="form-control" />
        </div>
    </div>

    <input asp-action="create" asp-controller="spaceship" type="submit" class="btn btn-primary" value="Create"/>
    <a asp-action="Index" asp-controller="spaceship" class="btn btn-secondary">Back to List</a>

</form>